# Copie para .env. Valores iguais aos do AI Gateway (app cliente Entra, não a API).

VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# URI Expor uma API, ex. api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_ENTRA_AUDIENCE=api://ai-gateway
# Vite (npm run dev): URL do Gateway. Vazio no build Docker (mesma origem no Nginx :8080).
VITE_GATEWAY_URL=http://127.0.0.1:8080
